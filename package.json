{
  "name": "caoguo-map",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "草果地图 —— 面向六张网的开源可私有化地图引擎与 AI 空间智能服务",
  "scripts": {
    "dev:landing": "pnpm --filter @caoguo/landing dev",
    "dev:docs": "pnpm --filter @caoguo/docs dev",
    "dev:demo": "pnpm --filter @caoguo/demo dev",
    "dev:editor": "pnpm --filter @caoguo/editor-app dev",
    "build:editor": "pnpm --filter @caoguo/map-editor build",
    "build": "pnpm -r build",
    "build:landing": "pnpm --filter @caoguo/landing build",
    "build:docs": "pnpm --filter @caoguo/docs build",
    "build:demo": "pnpm --filter @caoguo/demo build",
    "test": "pnpm -r test",
    "preview": "node tools/serve.mjs",
    "mock": "node tools/server/src/index.js",
    "preview:landing": "pnpm --filter @caoguo/landing preview",
    "preview:docs": "pnpm --filter @caoguo/docs preview",
    "preview:demo": "pnpm --filter @caoguo/demo preview",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
