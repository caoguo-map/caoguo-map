{
  "name": "@caoguo/maplibre-pipeline",
  "version": "0.0.7",
  "description": "草果地图管网组件包 - 爆管推演 / 泄漏扩散 / 健康评估 / 拓扑编辑器",
  "license": "Apache-2.0",
  "author": "caoguo <caoguo@hb.cn>",
  "homepage": "https://github.com/caoguo-map/maplibre-pipeline/blob/main/packages/pipeline/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoguo-map/maplibre-pipeline.git",
    "directory": "packages/pipeline"
  },
  "bugs": {
    "url": "https://github.com/caoguo-map/maplibre-pipeline/issues"
  },
  "keywords": [
    "maplibre",
    "caoguo",
    "gis",
    "pipeline",
    "underground-pipeline",
    "burst-simulation",
    "leakage-plume",
    "gaussian-plume",
    "pasquill-gifford",
    "health-assessment",
    "risk-heatmap",
    "graph-algorithm",
    "topology",
    "valve-planner",
    "nlpg",
    "china"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js",
      "require": "./dist/style/index.cjs"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "require": "./dist/graph/index.cjs"
    },
    "./burst": {
      "types": "./dist/burst/index.d.ts",
      "import": "./dist/burst/index.js",
      "require": "./dist/burst/index.cjs"
    },
    "./leakage": {
      "types": "./dist/leakage/index.d.ts",
      "import": "./dist/leakage/index.js",
      "require": "./dist/leakage/index.cjs"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js",
      "require": "./dist/health/index.cjs"
    },
    "./topology": {
      "types": "./dist/topology/index.d.ts",
      "import": "./dist/topology/index.js",
      "require": "./dist/topology/index.cjs"
    },
    "./nlpg": {
      "types": "./dist/nlpg/index.d.ts",
      "import": "./dist/nlpg/index.js",
      "require": "./dist/nlpg/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caoguo/maplibre": "workspace:*",
    "@caoguo/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
