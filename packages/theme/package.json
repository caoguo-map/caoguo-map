{
  "name": "@caoguo/theme",
  "version": "0.0.4",
  "description": "草果地图主题样式 — 矢量主题构造 + 暗/亮双套配色 + CSS 变量体系",
  "license": "Apache-2.0",
  "author": "caoguo <caoguo@hb.cn>",
  "homepage": "https://github.com/caoguo/map/blob/main/packages/theme/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoguo/map.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/caoguo/map/issues"
  },
  "keywords": [
    "maplibre",
    "theme",
    "map",
    "gis",
    "caoguo",
    "vector-tiles",
    "dark-theme",
    "light-theme",
    "css-variables"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
