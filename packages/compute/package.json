{
  "name": "@caoguo/maplibre-compute",
  "version": "0.0.7",
  "description": "草果地图算力网组件包 - 数据中心 / 边缘节点 / 光缆路由 / 延迟热力 / 供需预测",
  "license": "Apache-2.0",
  "author": "caoguo <caoguo@hb.cn>",
  "homepage": "https://github.com/caoguo-map/maplibre-compute/blob/main/packages/compute/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoguo-map/maplibre-compute.git",
    "directory": "packages/compute"
  },
  "bugs": {
    "url": "https://github.com/caoguo-map/maplibre-compute/issues"
  },
  "keywords": [
    "maplibre",
    "caoguo",
    "gis",
    "compute-network",
    "data-center",
    "edge-node",
    "fiber-route",
    "latency-map",
    "supply-demand",
    "routing",
    "graph-algorithm",
    "nlpg",
    "china"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js",
      "require": "./dist/style/index.cjs"
    },
    "./nodes": {
      "types": "./dist/nodes/index.d.ts",
      "import": "./dist/nodes/index.js",
      "require": "./dist/nodes/index.cjs"
    },
    "./latency": {
      "types": "./dist/latency/index.d.ts",
      "import": "./dist/latency/index.js",
      "require": "./dist/latency/index.cjs"
    },
    "./predict": {
      "types": "./dist/predict/index.d.ts",
      "import": "./dist/predict/index.js",
      "require": "./dist/predict/index.cjs"
    },
    "./nlpg": {
      "types": "./dist/nlpg/index.d.ts",
      "import": "./dist/nlpg/index.js",
      "require": "./dist/nlpg/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caoguo/maplibre": "workspace:*",
    "@caoguo/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
